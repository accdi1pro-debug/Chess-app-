<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="#2D2D2D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; AI Configuration"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- White Player Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="White Player:"
                android:textColor="#E0E0E0"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgWhitePlayerDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <Button
                    android:id="@+id/btnWhiteHumanDialog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Human" />

                <Button
                    android:id="@+id/btnWhiteAiDialog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Black Player Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Black Player:"
                android:textColor="#E0E0E0"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgBlackPlayerDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <Button
                    android:id="@+id/btnBlackHumanDialog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Human" />

                <Button
                    android:id="@+id/btnBlackAiDialog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- AI Thinking Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Search Time (Difficulty):"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgTimeLimitDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <Button
                    android:id="@+id/btnTime1sDialog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1s" />

                <Button
                    android:id="@+id/btnTime2sDialog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2s" />

                <Button
                    android:id="@+id/btnTime4sDialog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4s" />

                <Button
                    android:id="@+id/btnTime8sDialog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="8s" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Tournament Clock Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tournament Clock / Timer:"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgClockDurationDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <Button
                    android:id="@+id/btnClockNone"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Off"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnClock3m"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3 min"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnClock5m"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5 min"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnClock10m"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="10 min"
                    android:textSize="11sp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Light / Dark Mode Theme -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Theme (Light / Dark Mode):"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgThemeDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <Button
                    android:id="@+id/btnThemeSystem"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="System"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnThemeLight"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Light"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnThemeDark"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dark"
                    android:textSize="11sp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Random Color Switch -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchRandomColorDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Random Starting Color (Play as White or Black)"
            android:textColor="#E0E0E0"
            android:checked="false"
            android:layout_marginBottom="8dp" />

        <!-- 1v1 Rotate Pieces Switch -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoRotateDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rotate pieces on turn (1 v 1 mode)"
            android:textColor="#E0E0E0"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <!-- Manual Flip Pieces Switch -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchManualFlipDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rotate pieces 180° manually"
            android:textColor="#E0E0E0"
            android:checked="false"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Done" />

    </LinearLayout>
</ScrollView>
